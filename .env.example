# ==============================================================================
# CAL METER — Local Environment Configuration Placeholder
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# API Server
PORT=4000
HOST=0.0.0.0

# PostgreSQL Development Database URL
DATABASE_URL=postgresql://calmeter:calmeter@localhost:5432/calmeter_dev

# Dedicated PostgreSQL Test Database URL (STRICTLY REQUIRED for database integration tests)
# The test database guard enforces that this URL specifies 'calmeter_test' or a database ending in '_test'.
# Run test migrations via: npm run prisma:migrate:test
TEST_DATABASE_URL=postgresql://calmeter:calmeter@localhost:5432/calmeter_test

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Reverse Proxy Trust Configuration
# Options: 'false' (disabled / default), 'true' (all), <number> (hop count, e.g. 1), or IP/subnet string (e.g. 'loopback, linklocal')
TRUST_PROXY=false

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Request Body Limit
MAX_REQUEST_SIZE=100kb

# Firebase Admin SDK Configuration
# Mode: 'application-default' or 'service-account' (required explicitly in production)
FIREBASE_CREDENTIAL_MODE=application-default
FIREBASE_PROJECT_ID=calmeter-dev
# Required when FIREBASE_CREDENTIAL_MODE is 'service-account'
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Structured Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info
