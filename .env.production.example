# ==============================================================================
# CAL METER — Production Environment Configuration
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
CORS_ORIGINS=https://app.calmeter.com,https://calmeter.com

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://calmeter:your_secure_db_password@postgres:5432/calmeter_prod?schema=public&connection_limit=25&pool_timeout=10
POSTGRES_USER=calmeter
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=calmeter_prod

# Cache & Queues (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0

# Firebase Authentication & Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=calmeter-prod
FIREBASE_CREDENTIAL_MODE=service-account
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@calmeter-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloud Storage (AWS S3 / Cloudflare R2 for Food Photos)
S3_BUCKET_NAME=calmeter-prod-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# AI Vision & Nutrition Recognition Pipelines
GEMINI_API_KEY=your_production_gemini_api_key
OPENAI_API_KEY=your_production_openai_api_key

# RevenueCat Subscription Management & Webhook Secret
REVENUECAT_API_KEY=your_revenuecat_api_key
REVENUECAT_WEBHOOK_AUTH_TOKEN=your_secure_revenuecat_webhook_secret

# Open Food Facts API (Packaged Food Identification)
OPEN_FOOD_FACTS_USER_AGENT=CalMeter-Production/1.0.0 (contact@calmeter.com)

# Background Worker Settings
CONCURRENCY=5
LOG_LEVEL=info
